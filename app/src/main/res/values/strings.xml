    <!-- PermissionsActivity: permission cards, prompts, and status messages -->
    <string name="permissions_activity_text_001" formatted="false">ניהול הרשאות</string>
    <string name="permissions_activity_text_002" formatted="false">הרשאות הנדרשות לפעילות האפליקציה</string>
    <string name="permissions_activity_text_003" formatted="false">הרשאת גישה להתראות</string>
    <string name="permissions_activity_text_004" formatted="false">ההרשאה נדרשת כדי להציג את נגן המערכת, ולצורך כך יש לאפשר גישה להתראות</string>
    <string name="permissions_activity_text_005" formatted="false">הפעל הרשאת גישה להתראות</string>
    <string name="permissions_activity_text_006" formatted="false">כדי לשנות או לבטל את ההרשאה, שנה במסך הבא את הרשאת גישת להתראות של השומר מסך</string>
    <string name="permissions_activity_text_007" formatted="false">כדי לאפשר את הצגת הנגן, צריך לאפשר לשומר מסך גישה להתראות.\nבמסך הבא בחר את "שומר מסך" והפעל את ההרשאה</string>
    <string name="permissions_activity_text_008" formatted="false">הרשאת גישה לנתוני שימוש</string>
    <string name="permissions_activity_text_009" formatted="false">נדרשת לזיהוי אינטראקציות של המשתמש ואפליקציות שנמצאות בחזית. ההרשאה משמשת להפעלה בחוסר פעילות ולמניעת הפעלה אוטומטית בזמן שימוש.</string>
    <string name="permissions_activity_text_010" formatted="false">הפעל הרשאת גישה לנתוני שימוש</string>
    <string name="permissions_activity_text_011" formatted="false">כדי לשנות או לבטל את ההרשאה, שנה במסך הבא את הרשאת גיש לנתוני שימוש של השומר מסך</string>
    <string name="permissions_activity_text_012" formatted="false">כדי לזהות איזה אפליקציה פעילה במסך, בחר במסך הבא את "שומר מסך" ואפשר גישה לנתוני שימוש</string>
    <string name="permissions_activity_text_013" formatted="false">הרשאת תצוגה על אפליקציות</string>
    <string name="permissions_activity_text_014" formatted="false">ההרשאה נדרשת לצורך ההפעלה האוטומטית של השומר מסך, כדי שההפעלה תוכל להתבצע גם כאשר האפליקציה ברקע</string>
    <string name="permissions_activity_text_015" formatted="false">הפעל הרשאת תצוגה על אפליקציות</string>
    <string name="permissions_activity_text_016" formatted="false">כדי לשנות או לבטל את ההרשאה, שנה במסך הבא את הגדרת התצוגה מעל אפליקציות אחרות של השומר מסך</string>
    <string name="permissions_activity_text_017" formatted="false">כדי לאפשר הפעלה אוטומטית, בחר במסך הבא את "שומר מסך" ואפשר "תצוגה מעל אפליקציות אחרות"</string>
    <string name="permissions_activity_text_018" formatted="false">הרשאת מנהל מכשיר</string>
    <string name="permissions_activity_text_019" formatted="false">ההרשאה מאפשרת לאפליקציה לכבות את המסך ולנעול את המכשיר בעצמה בתום זמן הפעילות שנבחר.\nללא הרשאה זו, כיבוי המסך ונעילת המכשיר נשארים לפי הגדרות המכשיר</string>
    <string name="permissions_activity_text_020" formatted="false">הפעל הרשאת מנהל מכשיר</string>
    <string name="permissions_activity_text_021" formatted="false">כדי לאפשר את נעילת המכשיר בסיום זמן הפעילות, אשר במסך הבא את הרשאת מנהל המכשיר</string>
    <string name="permissions_activity_text_022" formatted="false">ההרשאה ניתנה - גישה להתראות פעילה</string>
    <string name="permissions_activity_text_023" formatted="false">ההרשאה עדיין לא ניתנה</string>
    <string name="permissions_activity_text_024" formatted="false">ניהול הרשאת גישה להתראות</string>
    <string name="permissions_activity_text_025" formatted="false">ההרשאה ניתנה - זיהוי אפליקציה פעילה זמין</string>
    <string name="permissions_activity_text_026" formatted="false">ניהול הרשאת גישה לנתוני שימוש</string>
    <string name="permissions_activity_text_027" formatted="false">ההרשאה ניתנה - תצוגה מעל אפליקציות אחרות פעילה</string>
    <string name="permissions_activity_text_028" formatted="false">ניהול הרשאת תצוגה מעל אפליקציות</string>
    <string name="permissions_activity_text_029" formatted="false">ההרשאה ניתנה - הרשאת מנהל המכשיר פעילה</string>
    <string name="permissions_activity_text_030" formatted="false">ההרשאה עדיין לא ניתנה</string>
    <string name="permissions_activity_text_031" formatted="false">בטל הרשאת מנהל מכשיר</string>
    <string name="permissions_activity_text_032" formatted="false">לא ניתן לפתוח את הגדרות ההתראות במכשיר</string>
    <string name="permissions_activity_text_033" formatted="false">לא ניתן לפתוח את הגדרות הגישה לנתוני שימוש במכשיר</string>
    <string name="permissions_activity_text_034" formatted="false">לא ניתן לפתוח את הגדרת ההרשאה.\nפתח בהגדרות Android את "תצוגה מעל אפליקציות אחרות"</string>
    <string name="permissions_activity_text_035" formatted="false">לא ניתן לפתוח את בקשת הרשאת מנהל המכשיר</string>
    <string name="permissions_activity_text_036" formatted="false">ביטול הרשאת מנהל מכשיר</string>
    <string name="permissions_activity_text_037" formatted="false">האם לבטל את ההרשאת מנהל מכשיר של השומר מסך?</string>
    <string name="permissions_activity_text_038" formatted="false">ביטול</string>
    <string name="permissions_activity_text_039" formatted="false">בטל הרשאה</string>
    <string name="permissions_activity_text_040" formatted="false">מבטל הרשאה…</string>
    <string name="permissions_activity_text_041" formatted="false">בקשת ביטול ההרשאה נשלחה ל־Android</string>
    <string name="permissions_activity_text_042" formatted="false">Android לא איפשר לבטל את ההרשאה מתוך האפליקציה.\nפתח את הגדרות האבטחה להמשך ידני</string>
    <string name="permissions_activity_text_043" formatted="false">לא ניתן להשלים את ביטול ההרשאה כרגע.\nפתח את הגדרות האבטחה להמשך ידני</string>
    <string name="permissions_activity_text_044" formatted="false">הרשאת מנהל המכשיר בוטלה בהצלחה</string>
    <string name="permissions_activity_text_045" formatted="false">Android עדיין מדווח שההרשאה פעילה.\nאפשר להשלים את הביטול דרך הגדרות האבטחה</string>
    <string name="permissions_activity_text_046" formatted="false">פתח הגדרות &gt; אבטחה &gt; אפליקציות מנהל מכשיר &gt; שומר מסך, כדי לבטל את ההרשאה</string>
    <!-- GuideActivity: full user guide sections -->
    <string name="guide_activity_text_001" formatted="false">מדריך שימוש</string>
    <string name="guide_activity_text_002" formatted="false">מדריך קצר לשימוש ולהגדרות שומר המסך.</string>
    <string name="guide_activity_text_003" formatted="false">מה יש בשומר המסך</string>
    <string name="guide_activity_text_004" formatted="false">שומר המסך מציג שעון ותאריך, ויכול להציג גם נגן מדיה ונתוני סוללה בזמן טעינה.\n\n</string>
    <string name="guide_activity_text_005" formatted="false"></string>
    <string name="guide_activity_text_006" formatted="false"></string>
    <string name="guide_activity_text_007" formatted="false">המסך הראשי</string>
    <string name="guide_activity_text_008" formatted="false">נגיעה באזור פנוי במסך מציגה את סמל ההגדרות לכשלוש שניות. הקש עליו כדי לפתוח את ההגדרות.\n\n</string>
    <string name="guide_activity_text_009" formatted="false"></string>
    <string name="guide_activity_text_010" formatted="false">כדי לצאת משומר המסך, </string>
    <string name="guide_activity_text_011" formatted="false">החלק כלפי מעלה מהקצה התחתון של המסך.</string>
    <string name="guide_activity_text_012" formatted="false">משך הפעילות ומסך הנעילה</string>
    <string name="guide_activity_text_013" formatted="false">„לפי המכשיר” מסתמך על זמן כיבוי המסך של Android. בחירה בדקה או בחמש דקות מסיימת את שומר המסך בתום הזמן; כיבוי המסך עצמו תלוי גם בהגדרות המכשיר.\n</string>
    <string name="guide_activity_text_014" formatted="false">„ללא כיבוי” משאירה את השומר פעיל ומונעת כיבוי אוטומטי של המסך. כדי לעצור אותו, יש לצאת ממנו.\n</string>
    <string name="guide_activity_text_015" formatted="false">עם הרשאת מנהל מכשיר, האפליקציה יכולה לבקש לנעול את המכשיר בסיום זמן הפעילות.\n\n</string>
    <string name="guide_activity_text_016" formatted="false"></string>
    <string name="guide_activity_text_017" formatted="false"></string>
    <string name="guide_activity_text_018" formatted="false"></string>
    <string name="guide_activity_text_019" formatted="false">מניעת נעילה בזמן פעילות והמשך הצגה במסך נעילה מטפלות במצבים שונים: בזמן הצגת השומר, ולאחר שהמסך כבה והמכשיר ננעל. במכשירים ללא מסך נעילה רגיל, האפשרויות האלה עשויות לא להיות רלוונטיות.\n\n</string>
    <string name="guide_activity_text_020" formatted="false"></string>
    <string name="guide_activity_text_021" formatted="false"></string>
    <string name="guide_activity_text_022" formatted="false"></string>
    <string name="guide_activity_text_023" formatted="false">הפעלה אוטומטית</string>
    <string name="guide_activity_text_024" formatted="false">אפשר להפעיל כמה מצבי הפעלה במקביל. בהפעלה בחוסר פעילות, ספירת הזמן מתחילה מרגע הפעלת האפשרות ונדרשת הרשאת גישה לנתוני שימוש.\n\n</string>
    <string name="guide_activity_text_025" formatted="false"></string>
    <string name="guide_activity_text_026" formatted="false"></string>
    <string name="guide_activity_text_027" formatted="false"></string>
    <string name="guide_activity_text_028" formatted="false"></string>
    <string name="guide_activity_text_029" formatted="false"></string>
    <string name="guide_activity_text_030" formatted="false"></string>
    <string name="guide_activity_text_031" formatted="false">שעון ותאריך</string>
    <string name="guide_activity_text_032" formatted="false"></string>
    <string name="guide_activity_text_033" formatted="false">יום השבוע מופיע לפני התאריך הלועזי. אם מוצג רק התאריך העברי, יום השבוע מופיע לפניו.</string>
    <string name="guide_activity_text_034" formatted="false"></string>
    <string name="guide_activity_text_035" formatted="false"></string>
    <string name="guide_activity_text_036" formatted="false"></string>
    <string name="guide_activity_text_037" formatted="false"></string>
    <string name="guide_activity_text_038" formatted="false">נגן מדיה</string>
    <string name="guide_activity_text_039" formatted="false">הנגן מציג מדיה פעילה במכשיר. שם האמן ותמונת האלבום יוצגו רק אם אפליקציית הנגינה מספקת אותם.</string>
    <string name="guide_activity_text_040" formatted="false"></string>
