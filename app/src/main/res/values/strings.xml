    <string name="settings_activity_text_270" formatted="false">הפעלה בחוסר פעילות</string>
    <string name="settings_activity_text_271" formatted="false">זמן חוסר פעילות</string>
    <string name="settings_activity_text_272" formatted="false">מעיר את המסך ומציג את השומר מסך למשך מספר שניות בכל מעבר שיר. בזמן טעינה בלבד</string>
    <string name="settings_activity_text_273" formatted="false">מפעילה את שומר המסך לאחר שלא זוהתה אינטראקציה של המשתמש לפי אירועי השימוש של Android במשך הזמן שנבחר. ההפעלה אינה מוגבלת למסך הבית, אך רמת הדיווח עשויה להשתנות בין מכשירים ואפליקציות.</string>
    <string name="settings_activity_text_274" formatted="false">הפעלת ההגדרה מחייבת הצגת נגן מדיה פעיל והרשאת גישה להתראות</string>
    <string name="settings_activity_text_275" formatted="false">משך הזמן ללא אינטראקציה של המשתמש לפני הפעלת שומר המסך.</string>
    <string name="settings_activity_text_276" formatted="false">ההפעלה דרך הגדרות Android עדיין אינה פעילה.\nפתח את הגדרות שומר המסך של Android, הפעל אותו, בחר בשומר המסך של האפליקציה והגדר הפעלה בזמן טעינה</string>
    <string name="settings_activity_text_277" formatted="false">כדי להדליק את ההגדרה, יש להפעיל תחילה גם את ההגדרה הצגת נגן המדיה</string>
    <string name="settings_activity_text_278" formatted="false">כדי לאפשר זיהוי מעבר שיר, יש לאפשר תחילה את ההרשאת גישה להתראות</string>
    <string name="settings_activity_text_279" formatted="false">כדי להפעיל שומר מסך בחוסר פעילות, יש לאפשר גישה לנתוני שימוש ותצוגה מעל אפליקציות אחרות.</string>
    <string name="settings_activity_text_280" formatted="false">חיפוש אפליקציה</string>
    <string name="settings_activity_text_281" formatted="false">לא נמצאו אפליקציות מתאימות</string>
    <string name="settings_activity_text_282" formatted="false">כדי לאפשר הפעלה אוטומטית כשהאפליקציה ברקע, יש לאפשר לשומר מסך הרשאת תצוגה מעל אפליקציות</string>
    <string name="settings_activity_text_283" formatted="false">לא ניתן לפתוח את הגדרות ההרשאה.\nפתח בהגדרות Android את "תצוגה מעל אפליקציות אחרות"</string>
    <string name="settings_activity_text_284" formatted="false">משך הצגה בתחילת שיר</string>
    <string name="settings_activity_text_285" formatted="false">מגדיר את משך הזמן בהגדרות הבאות- הצגת הנגן בתחילת שיר, הצגת פקדי הנגן בתחילת שיר, והדלקת המסך במעבר שיר בזמן טעינה</string>
    <string name="permission_sync_text_007" formatted="false">ההגדרה הפעלה האוטומטית בחוסר פעילות כובתה מפני שחסרה הרשאת נתוני שימוש או הרשאת תצוגה מעל אפליקציות</string>
    <string name="permission_sync_text_008" formatted="false">ההגדרה הדלקה במעבר שיר כובתה מפני שחסרה גישה להתראות או הרשאת תצוגה מעל אפליקציות</string>

