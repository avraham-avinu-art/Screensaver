    <string name="settings_activity_text_230" formatted="false">לא היה ניתן לפתוח את הגדרות שומר המסך של Android.\nפתח בעצמך בהגדרות, תבחר שם את שומר מסך והגדר הפעלה בזמן טעינה</string>
    <string name="settings_activity_text_231" formatted="false">כדי לאפשר הפעלה אוטומטית לאחר אתחול או התעוררות, יש לאפשר לשומר מסך הצגה מעל אפליקציות אחרות</string>
    <string name="settings_activity_text_232" formatted="false">כדי לזהות איזה אפליקציה פעילה במסך, יש לאפשר לשומר מסך "הרשאת גישה לנתוני שימוש"</string>
    <string name="settings_activity_text_233" formatted="false">איפוס לברירת מחדל</string>
    <string name="settings_activity_text_234" formatted="false">איפוס</string>
    <string name="settings_activity_text_235" formatted="false">לברירת המחדל</string>
    <string name="settings_activity_text_236" formatted="false">שמאלה</string>
    <string name="settings_activity_text_237" formatted="false">ימינה</string>
    <string name="settings_activity_text_238" formatted="false">לא זוהה שקיים במכשיר מסך נעילה. ולכן ההגדרות שקשורות למסך הנעילה עשויות שלא להיות רלוונטיות למכשיר זה</string>
    <string name="settings_activity_text_239" formatted="false">זוהתה במכשיר תמיכה ב־Android Automotive.\nבחלק ממערכות המולטימדיה אין מסך נעילה רגיל, ולכן הגדרות הקשורות לנעילה עשויות להיות לא רלוונטיות</string>
    <string name="settings_activity_text_240" formatted="false">לא ניתן לזהות את הגדרת זמן כיבוי המסך שמוגדר במכשיר.\nבסיום זמן הפעילות השומר מסך ייסגר, אך כיבוי המסך נשאר תלוי בהגדרות המכשיר</string>
    <string name="settings_activity_text_241" formatted="false">לא זוהה במכשיר כיבוי מסך אוטומטי. ולכן בבחירת זמן מסך מוקצב, השומר מסך ייסגר בתום הזמן, אך המסך עצמו עשוי להישאר דולק</string>
    <string name="settings_activity_text_242" formatted="false">זמן כיבוי המסך שמוגדר במכשיר ארוך מזמן הפעילות שבחרת.\nולכן בסיום הפעילות השומר מסך ייסגר, אך המסך ישאר פועל לפי הגדרות המכשיר</string>
    <string name="settings_activity_text_243" formatted="false">בחירת צבע מותאם אישית</string>
    <string name="settings_activity_text_245" formatted="false">גוון</string>
    <string name="settings_activity_text_246" formatted="false">רוויה</string>
    <string name="settings_activity_text_247" formatted="false">בהירות</string>
    <string name="settings_activity_text_248" formatted="false">ההפעלה האוטומטית יכולה לפעול, אך ההתראה המתמשכת לא תופיע במגירת ההתראות ללא הרשאת התראות</string>
    <string name="settings_activity_text_249" formatted="false">כדי לאפשר את הצגת הנגן, צריך לאפשר לשומר מסך גישה להתראות.\nבמסך הבא בחר את "שומר מסך" והפעל את ההרשאה</string>
    <string name="settings_activity_text_250" formatted="false">ההגדרה הצגת הנגן נשארה כבויה מפני שלא ניתנה הרשאת גישה להתראות</string>
    <string name="settings_activity_text_251" formatted="false">כדי לאפשר הפעלה אוטומטית בטעינה, בחר במסך הבא את "שומר מסך" ואפשר "תצוגה מעל אפליקציות אחרות"</string>
    <string name="settings_activity_text_252" formatted="false">ההגדרה הפעלה אוטומטית בטעינה נשארה כבויה מפני שלא ניתנה הרשאת "תצוגה מעל אפליקציות אחרות"</string>
    <string name="settings_activity_text_253" formatted="false">כדי לאפשר הפעלה אוטומטית בנעילה, אפשר במסך הבא לשומר מסך את ההרשאה "תצוגה מעל אפליקציות אחרות"</string>
    <string name="settings_activity_text_254" formatted="false">ההגדרה הפעלה האוטומטית בנעילת המכשיר נשארה כבויה מפני שלא ניתנה הרשאת "תצוגה מעל אפליקציות אחרות"</string>
    <string name="settings_activity_text_264" formatted="false">לא ניתן לפתוח את הגדרת ההרשאה.\nפתח בהגדרות Android את "תצוגה מעל אפליקציות אחרות"</string>
    <string name="settings_activity_text_265" formatted="false">לא ניתן לפתוח את הגדרות ההתראות במכשיר</string>
