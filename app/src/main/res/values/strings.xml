    <string name="guide_activity_text_059" formatted="false">ניהול הרשאות</string>
    <string name="guide_activity_text_060" formatted="false">במסך הזה אפשר לבדוק אילו הרשאות פעילות ולעבור להגדרות Android כדי לשנות אותן.\n\n</string>
    <string name="guide_activity_text_061" formatted="false"></string>
    <string name="guide_activity_text_062" formatted="false"></string>
    <string name="guide_activity_text_063" formatted="false"></string>
    <string name="guide_activity_text_064" formatted="false"></string>
    <string name="guide_activity_text_065" formatted="false">אם מבטלים הרשאה שנדרשת להגדרה מסוימת, ההגדרה התלויה בה תכובה אוטומטית.</string>
