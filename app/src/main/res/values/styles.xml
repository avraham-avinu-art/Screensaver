<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#3A4CA0</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">#F7F8FC</item>
        <item name="android:navigationBarColor">#F7F8FC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Hide the status bar before the launch window draws, avoiding a visible flash. -->
    <style name="AppTheme.Fullscreen" parent="@style/AppTheme">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
